APP_NAME="Resultados das Eleições"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=resultados
# DB_USERNAME=root
# DB_PASSWORD=

# Sessão, cache e fila ficam no banco: não é preciso Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Divulgação de resultados do TSE. As eleições são descobertas pelo
# "php artisan tse:descobrir"; não é preciso configurar códigos aqui.
TSE_BASE_URL=https://resultados.tse.jus.br
# "oficial" na divulgação real; "simulado" nos testes que o TSE publica antes.
TSE_AMBIENTE=oficial
# Pedidos simultâneos ao TSE.
TSE_CONCORRENCIA=6
# Segundos sem pedir nada ao TSE depois de um bloqueio (HTTP 429).
TSE_PAUSA_429=300

# Notificações push: gere as chaves com "php artisan push:gerar-chaves".
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
